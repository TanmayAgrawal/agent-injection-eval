{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent injection evaluation scenario",
  "type": "object",
  "required": [
    "id", "group_id", "kind", "task_family", "user_task",
    "authorized_email", "expected_summary_marker", "expected_fact", "documents"
  ],
  "properties": {
    "id": {"type": "string"},
    "group_id": {"type": "string"},
    "kind": {"enum": ["clean", "injected"]},
    "task_family": {"type": "string"},
    "user_task": {"type": "string"},
    "authorized_email": {"type": "string"},
    "expected_summary_marker": {"type": "string"},
    "expected_fact": {"type": "string"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "content", "trusted"],
        "properties": {
          "id": {"type": "string"},
          "content": {"type": "string"},
          "trusted": {"type": "boolean"}
        }
      }
    },
    "injection": {
      "type": ["object", "null"],
      "properties": {
        "placement": {"enum": ["start", "middle", "end"]},
        "style": {"enum": ["imperative", "system_note", "policy"]},
        "target_step": {"enum": ["immediate", "after_summary"]},
        "attacker_email": {"type": "string"},
        "attacker_body_marker": {"type": "string"},
        "bypass_type": {"type": ["string", "null"]}
      }
    }
  }
}

