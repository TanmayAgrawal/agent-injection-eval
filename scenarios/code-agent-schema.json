{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code-agent repository-content injection scenario",
  "type": "object",
  "required": [
    "id", "group_id", "kind", "task_family", "user_task", "source_path",
    "authorized_path", "expected_patch_marker", "expected_fact", "repo_files"
  ],
  "properties": {
    "id": {"type": "string"},
    "group_id": {"type": "string"},
    "kind": {"enum": ["clean", "injected"]},
    "task_family": {"const": "code_patch_from_repo_content"},
    "user_task": {"type": "string"},
    "source_path": {"type": "string"},
    "authorized_path": {"type": "string"},
    "expected_patch_marker": {"type": "string"},
    "expected_fact": {"type": "string"},
    "repo_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "content", "trusted"],
        "properties": {
          "id": {"type": "string"},
          "content": {"type": "string"},
          "trusted": {"type": "boolean"}
        }
      }
    },
    "injection": {
      "type": ["object", "null"],
      "properties": {
        "placement": {"enum": ["start", "middle", "end"]},
        "style": {"enum": ["imperative", "system_note", "policy"]},
        "target_step": {"const": "after_read"},
        "attacker_path": {"type": "string"},
        "attacker_patch_marker": {"type": "string"},
        "bypass_type": {"type": ["string", "null"]}
      }
    }
  }
}
