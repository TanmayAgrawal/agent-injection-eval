{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent evaluation run trace",
  "type": "object",
  "required": [
    "schema_version", "run_id", "scenario_id", "scenario_group_id",
    "scenario_kind", "rep", "seed", "config", "env", "steps",
    "proposed_calls", "executed_calls", "labels", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "scenario_group_id": {"type": "string"},
    "scenario_kind": {"enum": ["clean", "injected"]},
    "rep": {"type": "integer", "minimum": 0},
    "seed": {"type": "integer"},
    "config": {"type": "object"},
    "env": {"type": "object"},
    "steps": {"type": "array"},
    "proposed_calls": {"type": "array"},
    "executed_calls": {"type": "array"},
    "labels": {
      "type": "object",
      "required": [
        "attempted_privileged", "executed_privileged", "attempted_attacker_args",
        "executed_attacker_args", "task_completed", "blocked", "false_block"
      ]
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
